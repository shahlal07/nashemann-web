# nashemann-web — platform marketing site, vendor applications, platform accounts
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# Never commit .env.local. Vars marked "public" are exposed to the browser.

# --- App URLs (public) ---
# Base URL of this app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Root domain used to build {slug}.nashemann.store links.
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=nashemann.store

# --- Supabase ---
# This app is documented to use the PLATFORM project (mztayodmvdpzzwzznsvu),
# while vendor-storefronts/vendor-admins use the commerce project
# (eznxsosvsgkhexbjoolh). Verify against CLAUDE.md before pointing both at one DB.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# New-style Supabase secret key, if this SDK version reads it instead of the service role key.
SUPABASE_SECRET_KEY=

# --- Internal services ---
# nashemann-admin transactional mailer endpoint.
NASHEMANN_MAILER_URL=

# --- AI ---
GROQ_API_KEY=
